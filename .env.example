APP_NAME=RocketNews
APP_PORT=3000
DEFAULT_LANG=vi

# Database (PostgreSQL / Supabase)
# DB_HOST is a bare hostname without scheme, eg db.<project-ref>.supabase.co
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_USER=<db-user>
DB_PASSWORD=<fill-me>
DB_NAME=<db-name>
DB_SCHEMA=public

# Redis (token blacklist)
REDIS_URL=rediss://default:<token>@<region>.upstash.io:6379

# Auth (pull 2.2)
# Generate a signing key with: openssl rand -hex 32
JWT_SECRET=<fill-me-at-least-32-chars>
# Token lifetime: seconds, or suffixed with s/m/h/d, range 60s - 24h
JWT_EXPIRES_IN=15m
